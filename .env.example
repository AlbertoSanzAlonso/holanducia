# VPS — docker compose (copiar a .env en el servidor)
GROQ_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=

# Opcional — umbrales dedup vectorial
# VECTOR_DUPLICATE_THRESHOLD=0.92
# VECTOR_UPDATE_THRESHOLD=0.75

# Facebook — login automatizado suele fallar; alternativa: exportar sesión Playwright
FB_USER=
FB_PASSWORD=
# FB_SESSION_B64=   # base64 de scrapers/debug/fb_session.json (python scrapers/export_fb_session.py)
# FB_SCROLL_STEPS=55  # pasos de scroll por grupo Facebook (más = más posts)

# Sync diario automático (worker)
# DAILY_SYNC_ENABLED=true
# DAILY_SYNC_HOUR=7       # hora local del servidor (UTC en VPS)
# DAILY_SYNC_TARGET=200   # anuncios a procesar por sync
