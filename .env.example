# VPS — docker compose (copiar a .env en el servidor)
GROQ_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=

# LLM del worker (Analyst, Supervisor, Classifier)
# LLM_PROVIDER=auto       # auto | groq | openai — auto: Groq primero, fallback OpenAI en 429
# LLM_MAX_CONCURRENT=2    # llamadas IA simultáneas (bajar si hay 429)
# LLM_RETRY_MAX=2
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile

# Opcional — umbrales dedup vectorial
# VECTOR_DUPLICATE_THRESHOLD=0.92
# VECTOR_UPDATE_THRESHOLD=0.75

# Facebook — login automatizado suele fallar; alternativa: exportar sesión Playwright
FB_USER=
FB_PASSWORD=
# FB_SESSION_B64=   # base64 de scrapers/debug/fb_session.json (python scrapers/export_fb_session.py)
# FB_SCROLL_STEPS=55
# FB_CLASSIFIER_MIN_CONFIDENCE=0.85  # umbral IA clasificador inmobiliario (0-1)

# Sync diario automático (worker)
# DAILY_SYNC_ENABLED=true
# DAILY_SYNC_HOUR=7       # hora local del servidor (UTC en VPS)
# MASS_SCRAPE_TARGET=500  # cuota por sync masivo (preferir user_settings en BD)
# MASS_FB_SCROLL_STEPS=100
